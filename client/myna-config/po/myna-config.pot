#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:33
msgid "When to transcribe"
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:34
msgid ""
"As you speak shows partial text in the field while you talk; When you stop "
"injects the whole transcript once the utterance ends; Automatic picks per "
"machine from the measured RTF table."
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:43
msgid "Spoken language"
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:44
msgid ""
"A BCP-47-ish code (en, fr, zh) for the language you dictate in. The backend "
"skips language detection and decodes in this language; a code that does not "
"match what is spoken degrades the transcript. Empty lets the backend decide."
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:54
msgid "Indicator style"
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:55
msgid ""
"All four render the same calibrated audio envelope: Default is a level bar "
"in the accent colour, Ribbon a flowing GPU wave, VU meter a segmented meter, "
"Progress a plain progress bar."
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:65
msgid "Stop after silence (seconds)"
msgstr ""

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:66
msgid ""
"With tap-to-start activation, end the dictation session on its own after "
"this many seconds without speech. 0 keeps it running until the next tap. "
"Hold-to-talk always ends with the key."
msgstr ""

#: data/com.canonical.Myna.Config.metainfo.xml:9
msgid "Set up and configure local dictation"
msgstr ""

#: data/com.canonical.Myna.Config.metainfo.xml:14
msgid ""
"Myna turns speech into text on your computer, with no audio or text leaving "
"it. Myna Settings guides you through installing it and a speech model, then "
"configures dictation and its speech backends."
msgstr ""

