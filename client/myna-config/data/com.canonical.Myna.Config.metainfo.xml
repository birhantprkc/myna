  <name>Myna Settings</name>
  <summary>Set up and configure local dictation</summary>
  <developer id="com.canonical">
    <name translate="no">Canonical</name>
  </developer>
  <description>
    <p>
      Myna turns speech into text on your computer, with no audio or text
      leaving it. Myna Settings guides you through installing it and a speech
      model, then configures dictation and its speech models.
    </p>
  </description>

  <url type="homepage">https://github.com/canonical/myna</url>

  <launchable type="desktop-id">com.canonical.Myna.Config.desktop</launchable>
  <provides>
    <binary>myna-config</binary>
  </provides>
  <translation type="gettext">myna-config</translation>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
</component>
