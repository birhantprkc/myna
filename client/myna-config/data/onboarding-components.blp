using Gtk 4.0;
using Adw 1;

template $OnboardingComponents: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        $BalancedLabel {
          label: _("Install components");
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        $BalancedLabel {
          label: _("You need to install some components for Dictation to work.");
          margin-bottom: 32;
        }

        Gtk.ListBox {
          selection-mode: none;
          margin-bottom: 16;

          styles [
            "boxed-list",
          ]

          Adw.ActionRow flag_row {
            title: _("Enable user daemons experimental support");
            subtitle: _("Required by the Dictation app");
            activatable-widget: flag_switch;

            [suffix]
            Gtk.Switch flag_switch {
              valign: center;
            }
          }
        }

        Gtk.ListBox component_list {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.ActionRow myna_row {
            title: _("Dictation app");

            [suffix]
            Gtk.Button myna_button {
              valign: center;
              width-request: 120;

              styles [
                "outlined",
              ]
            }

            [suffix]
            Gtk.Box myna_installed {
              spacing: 8;
              visible: false;

              Gtk.Image {
                icon-name: "object-select-symbolic";

                styles [
                  "success",
                ]
              }

              Gtk.Label {
                label: _("Installed");
              }
            }
          }

          Adw.ActionRow model_row {
            title: _("Speech-to-text model");

            [suffix]
            Gtk.Button model_button {
              valign: center;
              width-request: 120;

              styles [
                "outlined",
              ]
            }

            [suffix]
            Gtk.Box model_installed {
              spacing: 8;
              visible: false;

              Gtk.Image {
                icon-name: "object-select-symbolic";

                styles [
                  "success",
                ]
              }

              Gtk.Label {
                label: _("Installed");
              }
            }
          }

          Adw.ActionRow extension_row {
            title: _("Shell extension");

            [suffix]
            Gtk.Button extension_button {
              valign: center;
              width-request: 120;

              styles [
                "outlined",
              ]
            }

            [suffix]
            Gtk.Box extension_installed {
              spacing: 8;
              visible: false;

              Gtk.Image {
                icon-name: "object-select-symbolic";

                styles [
                  "success",
                ]
              }

              Gtk.Label {
                label: _("Installed");
              }
            }
          }
        }
      };
    };
  };
}
