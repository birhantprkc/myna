using Gtk 4.0;
using Adw 1;

template $OnboardingComponents: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        $BalancedLabel {
          label: _("Install components");
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        $BalancedLabel {
          label: _("You need to install some components for Dictation to work.");
          margin-bottom: 32;
        }

        Gtk.ListBox {
          selection-mode: none;
          margin-bottom: 16;

          styles [
            "boxed-list",
          ]

          Adw.ActionRow flag_row {
            title: _("Let Myna run in the background");
            subtitle: _("Dictation needs it. Sets experimental.user-daemons in snapd.");
            activatable-widget: flag_switch;

            [suffix]
            Gtk.Spinner flag_spinner {
              visible: false;
              valign: center;

              accessibility {
                label: _("Letting Myna run in the background");
              }
            }

            [suffix]
            Gtk.Switch flag_switch {
              valign: center;
            }
          }
        }

        Gtk.ListBox component_list {
          selection-mode: none;

          styles [
            "boxed-list",
            "onboarding-components",
          ]

          Adw.ActionRow myna_row {
            title: _("Dictation app");

            [suffix]
            $InstallControl myna_control {}
          }

          Adw.ActionRow model_row {
            title: _("Speech-to-text model");

            [suffix]
            $InstallControl model_control {}
          }

          Adw.ActionRow extension_row {
            title: _("Shell extension");

            [suffix]
            $InstallControl extension_control {}
          }
        }
      };
    };
  };
}
