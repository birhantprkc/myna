using Gtk 4.0;
using Adw 1;

template $OnboardingWelcome: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        Gtk.Image {
          icon-name: "com.canonical.Myna.Config";
          pixel-size: 96;
          margin-bottom: 12;
        }

        Gtk.Label {
          label: _("Set up Dictation");
          justify: center;
          wrap: true;
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        Gtk.Label {
          label: _("Dictation runs locally, with no data leaving your computer.");
          justify: center;
          wrap: true;
        }
      };
    };
  };
}
