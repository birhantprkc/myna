using Gtk 4.0;
using Adw 1;

template $OnboardingShortcut: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        $BalancedLabel {
          label: _("How to dictate");
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        $BalancedLabel description {
          margin-bottom: 32;
        }

        // As high as a row of key caps even with none, so the page stays put
        // when the desktop grants a key.
        Gtk.Stack key_slot {
          vhomogeneous: true;
          hhomogeneous: false;
          margin-bottom: 24;

          Gtk.StackPage {
            name: "none";

            child: Gtk.Box {};
          }

          Gtk.StackPage {
            name: "keys";

            child: Gtk.Box shortcut_box {
              halign: center;
              spacing: 8;
            };
          }

          Gtk.StackPage {
            name: "sample";

            child: Gtk.Label {
              label: "J";

              styles [
                "keycap",
              ]
            };
          }
        }

        Gtk.Button shortcut_button {
          label: _("Set up shortcut");
          halign: center;
          sensitive: false;

          styles [
            "outlined",
          ]
        }
      };
    };
  };
}
