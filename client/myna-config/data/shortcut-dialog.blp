using Gtk 4.0;
using Adw 1;

template $ShortcutDialog: Adw.Dialog {
  title: _("Set Shortcut");
  content-width: 400;
  // libadwaita 1.5 focuses nothing in a dialog without a focusable child,
  // and key events only reach the focused widget's ancestors.
  focus-widget: capture;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Box capture {
      focusable: true;
      orientation: vertical;
      spacing: 12;
      margin-start: 24;
      margin-end: 24;
      margin-top: 12;
      margin-bottom: 24;

      Gtk.Label {
        label: _("Press the keys for dictation, for example Super+J.");
        justify: center;
        wrap: true;
      }

      Gtk.Label refusal {
        visible: false;
        justify: center;
        wrap: true;

        styles [
          "error",
        ]
      }

      Gtk.Label {
        label: _("Press Escape to cancel.");
        justify: center;
        wrap: true;

        styles [
          "dim-label",
        ]
      }
    };
  };
}
