using Gtk 4.0;
using Adw 1;

template $ShortcutDialog: Adw.Dialog {
  title: _("Set Shortcut");
  content-width: 400;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Box {
      orientation: vertical;
      spacing: 12;
      margin-start: 24;
      margin-end: 24;
      margin-top: 12;
      margin-bottom: 24;

      Gtk.Label {
        label: _("Press the keys for dictation, for example Super+J.");
        justify: center;
        wrap: true;
      }

      Gtk.Label {
        label: _("Press Escape to cancel.");
        justify: center;
        wrap: true;

        styles [
          "dim-label",
        ]
      }
    };
  };
}
