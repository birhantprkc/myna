using Gtk 4.0;
using Adw 1;

template $OnboardingWindow: Adw.ApplicationWindow {
  default-width: 800;
  default-height: 600;
  title: _("Dictation");

  content: Adw.ToastOverlay overlay {
    child: Adw.ToolbarView {
      content: Adw.NavigationView navigation {};

      [bottom]
      Gtk.Box actions {
        margin-start: 24;
        margin-end: 24;
        margin-top: 12;
        margin-bottom: 24;

        Gtk.Button forward_button {
          label: _("Next");
          sensitive: false;
          halign: end;
          hexpand: true;
          width-request: 136;

          accessibility {
            description: _("Continue to the next onboarding step.");
          }
        }
      }
    };
  };
}
